# Protect live content edited via admin panel
content.json
train-content.json
train-users.json
services-content.json

# Database config (contains credentials)
config.php

# Cache files
map-pins-cache.json
ig_cache.json

# Backups created by save.php
backups/

# Uploaded images (managed via admin, not repo)
img/uploads/

